# Copier ce fichier en .env (jamais commité). Lu par le serveur (npm run dev) et par npm run deploy:sepolia.

# ---------------------------------------------------------------------------
# Sepolia (obligatoire pour npm run deploy:sepolia)
# ---------------------------------------------------------------------------
# URL RPC Sepolia : gratuite chez Infura, Alchemy, ou publique (ex. https://ethereum-sepolia-rpc.publicnode.com)
SEPOLIA_RPC_URL=
# Clé privée d'un compte MetaMask DÉDIÉ AUX TESTS, crédité via un faucet Sepolia. Jamais un compte avec de vrais fonds.
# Ce compte devient l'administrateur (propriétaire de l'usine à tirages).
DEPLOYER_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Oracle de hasard Chainlink VRF v2.5 (optionnel : valeurs Sepolia officielles par défaut)
# ---------------------------------------------------------------------------
# ETH de test versés à la réserve de l'oracle au déploiement (sinon : depuis l'Espace admin).
VRF_FUND_ETH=0.1
# Laisser vide : l'usine crée son propre abonnement Chainlink. Sinon, numéro d'un abonnement existant
# (il faut alors ajouter l'adresse de l'usine comme « consumer » sur https://vrf.chain.link).
VRF_SUBSCRIPTION_ID=
# true : l'oracle est payé en ETH ; false : en LINK (abonnement à alimenter en LINK sur vrf.chain.link).
VRF_NATIVE_PAYMENT=true
# VRF_COORDINATOR=0x9DdfaCa8183c41ad55329BdeeD9F6A8d53168B1B
# VRF_KEY_HASH=0x787d74caea10b2b357790d5b5247c2f63d1d91572a9846f780606e4d953677ae

# ---------------------------------------------------------------------------
# Premier tirage créé au déploiement (optionnel)
# ---------------------------------------------------------------------------
# DRAW_DURATION_SECONDS=3600
# DRAW_CAPACITY=100
# DRAW_MAX_PER_PLAYER=25

# ---------------------------------------------------------------------------
# Robinet BlockLucky (optionnel)
# ---------------------------------------------------------------------------
# Compte qui envoie les ETH de test sur Sepolia (par défaut : DEPLOYER_PRIVATE_KEY). En local : compte Ganache n° 9.
# FAUCET_PRIVATE_KEY=
# FAUCET_AMOUNT_ETH=0.02
# FAUCET_DAILY_LIMIT_ETH=0.2

# ---------------------------------------------------------------------------
# Jouer depuis un téléphone (optionnel)
# ---------------------------------------------------------------------------
# Par défaut, seul cet ordinateur peut ouvrir le site. 0.0.0.0 l'ouvre aux appareils du même Wi-Fi
# (le tuto « App mobile » affiche alors l'adresse à taper dans l'app MetaMask). En local, lancer aussi
# Ganache avec « npm run chain:lan ». À n'activer que sur un réseau de confiance.
# HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Comptes (optionnel)
# ---------------------------------------------------------------------------
# E-mails qui deviennent administrateurs à leur inscription, séparés par des virgules.
# Si vide, le tout premier compte créé devient administrateur.
# ADMIN_EMAILS=moi@exemple.fr
